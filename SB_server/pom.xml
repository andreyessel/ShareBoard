

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>server</groupId>
    <artifactId>SB_server</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <rest-assured.version>5.4.0</rest-assured.version>
        <testng.version>7.10.1</testng.version>
    </properties>

    <dependencies>
        <!-- REST controllers: ListingController, AuthController, MatchController -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Dev convenience: auto-restart on save, same as your pre-capstone -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JdbcClient — your repository layer -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- @Valid — quantity > 0, category required, urgency/deadline rules -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- CAPSTONE-SPECIFIC — your pre-capstone doesn't need this.
             This is the MVP-required live push: /topic/listings/{categoryId}
             updating instantly when a match happens. Without this dependency,
             Day 4's entire requirement is impossible to build. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Driver, version managed by the parent, only needed at runtime -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JUnit 5 + Mockito, JUnit 4 vintage engine excluded — same as pre-capstone -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ============================================================
             QA AUTOMATION ADDITIONS BELOW
             REST Assured + TestNG — black-box API test suite that hits
             the running app over HTTP (localhost:8080), separate from
             the JUnit/Mockito unit + repository tests above.
             ============================================================ -->

        <!-- REST Assured: fluent HTTP assertions for the REST API -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Handy matchers used alongside REST Assured's then().body(...) -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-path</artifactId>
            <version>${rest-assured.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- TestNG: the automation framework named in the job description -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Deliberately NOT touching maven-surefire-plugin: `mvn test`
                 keeps running your existing JUnit/Mockito tests exactly as
                 before, against shareboard_test, untouched by anything below.

                 The REST Assured/TestNG suite runs through Failsafe instead
                 — the plugin Maven designed for exactly this ("hits a real
                 running instance over HTTP") kind of test, kept in a
                 separate phase (integration-test/verify) so it can never
                 collide with Surefire's JUnit run or its provider selection.
                 Classes ending in `IT` (AuthApiIT, ListingApiIT, etc.) are
                 picked up by Failsafe's default naming convention; Surefire's
                 default convention explicitly excludes them.

                 Run with: mvn verify -Dsurefire.skip=true
                 (see TESTING_SETUP.md for why -Dsurefire.skip is needed) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
